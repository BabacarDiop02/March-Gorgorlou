# Configuration de la base de données (PostgreSQL / Supabase)
# Exemple: postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="votre_url_supabase_ici"

# Secret pour les tokens JWT
JWT_SECRET="votre_secret_tres_long_et_securise"

# Port du serveur (optionnel)
PORT=3000
